+static bb_t knight_table[64], king_table[64], pawn_attack_table[2][64], ray_table[8][64];
+static const int ray_df[8] = {0, 1, 1, -1, 0, -1, 1, -1};
+static const int ray_dr[8] = {1, 0, 1, 1, -1, 0, -1, -1};
