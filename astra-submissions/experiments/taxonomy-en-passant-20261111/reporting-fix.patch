+def captured_piece(before: chess.Board, after: chess.Board, uci: str):
+    """Victim and its square, including EP, on a rules-validated transition.
+
+    Standalone frame FENs omit en-passant rights. Use the pawn's observed
+    transition and removed adjacent pawn, without inventing those rights.
+    """
+    src, dst = chess.parse_square(uci[:2]), chess.parse_square(uci[2:4])
+    victim = before.piece_at(dst)
+    if victim is not None:
+        return victim, dst
+    piece = before.piece_at(src)
+    if piece is None or piece.piece_type != chess.PAWN:
+        return None, None
+    rank = chess.square_rank(src)
+    direction = 1 if piece.color else -1
+    if rank != (4 if piece.color else 3) or chess.square_rank(dst) != rank + direction:
+        return None, None
+    if abs(chess.square_file(src) - chess.square_file(dst)) != 1:
+        return None, None
+    square = chess.square(chess.square_file(dst), rank)
+    victim = before.piece_at(square)
+    if (victim is not None and victim.piece_type == chess.PAWN and victim.color != piece.color
+            and after.piece_at(square) is None and after.piece_at(src) is None
+            and after.piece_at(dst) == piece):
+        return victim, square
+    return None, None
 
 
