+def risk_coefficients(cfg):
+    """Optional auxiliary supervision; legacy PPO is unchanged when disabled."""
+    coef = float(cfg.get("risk_aux_coef", 0.0))
+    separation = float(cfg.get("risk_separation_coef", 0.0))
+    if not all(math.isfinite(x) and x >= 0 for x in (coef, separation)):
+        raise ValueError("risk coefficients must be finite and nonnegative")
+    if coef == 0 and separation != 0:
+        raise ValueError("risk_separation_coef requires positive risk_aux_coef")
+    return coef, separation
